# Local Compose only. Staging/production values belong in a managed secret store.
POSTGRES_PASSWORD=replace-with-a-local-password
SOCRAT_SESSION_SECRET=replace-with-at-least-48-random-characters

# Deployment configuration (never enable local login outside development/test).
SOCRAT_ENVIRONMENT=staging
SOCRAT_PUBLIC_ORIGIN=https://staging.example.com
SOCRAT_DATABASE_URL=postgresql+psycopg://user:password@host:5432/socrat
SOCRAT_DEV_LOGIN_ENABLED=false
SOCRAT_OIDC_ISSUER=https://identity.example.com
SOCRAT_OIDC_CLIENT_ID=replace-me
SOCRAT_OIDC_CLIENT_SECRET=replace-me
SOCRAT_METRICS_TOKEN=replace-with-at-least-32-random-characters

# M2 editorial access: explicit issuer+subject pairs; disabled until configured.
# Keep real administrator identities in private deployment configuration.
SOCRAT_CONTENT_ADMIN_IDENTITIES=[]

# M3 onboarding: enable explicitly after environment and coverage checks.
SOCRAT_ONBOARDING_ENABLED=false
SOCRAT_DIAGNOSTICS_ENABLED=false

# M5 planner: enable only with released practice coverage and diagnostic evidence.
SOCRAT_PLANNING_ENABLED=false
SOCRAT_LEARNING_SESSIONS_ENABLED=false
SOCRAT_ASSESSMENTS_ENABLED=false

# M6 stays disabled until the dedicated execution host passes its release gate.
SOCRAT_EXECUTION_ENABLED=false
SOCRAT_EXECUTION_PROFILES=[]
SOCRAT_EXECUTION_DAILY_QUOTA=100
SOCRAT_EXECUTION_QUEUE_LIMIT=4
SOCRAT_EXECUTION_IP_DAILY_QUOTA=500
SOCRAT_EXECUTION_GLOBAL_QUEUE_LIMIT=100
# Use managed secret files; never put runtime credentials in learner images.
SOCRAT_EXECUTION_SIGNING_SECRET_FILE=
SOCRAT_EXECUTION_WORKER_SECRET_FILE=

# M8: curated assistance and model access have independent kill switches.
SOCRAT_TUTOR_ENABLED=false

# The one AI provider behind the tutor, lessons, the trial and the playground.
SOCRAT_AI_PROVIDER=openai
# Blank for api.openai.com; set only for an OpenAI-compatible endpoint (vLLM, Nebius, ...).
SOCRAT_OPENAI_BASE_URL=
SOCRAT_OPENAI_MODEL=gpt-5.4-mini
# Put the actual key in private .env (or SOCRAT_OPENAI_API_KEY_FILE), never in this example file.
SOCRAT_OPENAI_API_KEY=
SOCRAT_DASHBOARD_ENABLED=false
SOCRAT_REMINDERS_ENABLED=false

# AI-authored visual playground: uses the AI provider above.
# Production requires a separate registrable sandbox domain and the isolated browser checker.
SOCRAT_EXPLAINER_ENABLED=true
# Optional code-generation model override; blank inherits the assistant model.
SOCRAT_EXPLAINER_MODEL=
# Compatible endpoints only (ignored for api.openai.com), e.g. {"enable_thinking":false} for Qwen3.
SOCRAT_EXPLAINER_CHAT_TEMPLATE_KWARGS={}
SOCRAT_EXPLAINER_DAILY_MESSAGES=20
# 3D models are in testing: admin accounts only. false opens them to every learner.
SOCRAT_EXPLAINER_3D_ADMIN_ONLY=true
SOCRAT_EXPLAINER_3D_MODEL=
SOCRAT_EXPLAINER_CONCURRENT_LIMIT=4
SOCRAT_EXPLAINER_SANDBOX_ORIGIN=https://visuals.example.net
# Also pass this public value as a web image build argument for the frame-src CSP.
NEXT_PUBLIC_EXPLAINER_SANDBOX_ORIGIN=https://visuals.example.net
SOCRAT_EXPLAINER_CHECKER_URL=http://explainer-checker:8010/check
SOCRAT_EXPLAINER_CHECKER_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# LLM cost guardrails (estimated from token counts; 0 = no cap). AI_ENABLED=false is the kill switch.
SOCRAT_AI_ENABLED=true
# Per-million-token prices of SOCRAT_OPENAI_MODEL (these are GPT-5.4 mini's).
SOCRAT_AI_PRICE_INPUT_PER_MTOK=0.75
SOCRAT_AI_PRICE_OUTPUT_PER_MTOK=4.5
SOCRAT_AI_USER_DAILY_BUDGET_USD=0.5
SOCRAT_AI_DAILY_BUDGET_USD=25
SOCRAT_AI_MONTHLY_BUDGET_USD=400
# Python and C++ run in the learner's browser; set to [] to use only server workers.
SOCRAT_BROWSER_RUNTIMES=["python","cpp"]

# Email-and-password accounts. Codes are sent through Resend from a domain verified there;
# without a key, development writes the codes to the API log and production hides email sign-in.
SOCRAT_EMAIL_FROM="Socrat <no-reply@example.com>"
SOCRAT_RESEND_API_KEY=

# Freemium billing: Razorpay Subscriptions. Keys come from the dashboard (test keys start rzp_test_).
SOCRAT_BILLING_ENABLED=false
SOCRAT_RAZORPAY_KEY_ID=
SOCRAT_RAZORPAY_KEY_SECRET=
SOCRAT_RAZORPAY_WEBHOOK_SECRET=
